{
  "containerDefinitions": [
    {
      "name": "auth-service",
      "image": "359554405287.dkr.ecr.ap-south-1.amazonaws.com/auth-service:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "postgres"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://ecommerce-test-db.cfo2w0oc4rko.ap-south-1.rds.amazonaws.com:5432/postgres"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "TestPass123!"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/auth-service",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "auth-service",
  "taskRoleArn": "arn:aws:iam::359554405287:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::359554405287:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
